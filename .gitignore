[Tt]est[Rr]esult*/
*.trx
coverage*.json
coverage*.xml
*.coverage
*.coveragexml

# --------------------------------------------------
# Memory Dumps & Diagnostics
# --------------------------------------------------
*.dmp
*.dump
*.crashdump
BenchmarkDotNet.Artifacts/

# --------------------------------------------------
# Database Files & Local Storage
# --------------------------------------------------
*.mdf
*.ldf
*.ndf
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# --------------------------------------------------
# Security, Certificates & Secrets
# --------------------------------------------------
*.pfx
*.p12
*.key
*.pem
*.crt
*.cer
*.der
secrets.json
.env
.env.*
!.env.example
!.env.template

# --------------------------------------------------
# User Secrets & Local Appsettings Overrides
# --------------------------------------------------
appsettings*.local.json
appsettings.local.json
appsettings.Development.local.json
appsettings.Production.local.json
appsettings.secrets.json

# --------------------------------------------------
# Application Runtime Uploads (Lab 18 & Future Labs)
# Preserve directory structure via .gitkeep
# --------------------------------------------------
**/wwwroot/Files/**/*
!**/wwwroot/Files/**/.gitkeep
**/wwwroot/Uploads/**/*
!**/wwwroot/Uploads/**/.gitkeep
**/wwwroot/uploads/**/*
!**/wwwroot/uploads/**/.gitkeep
**/Files/**/*
!**/Files/**/.gitkeep
**/Uploads/**/*
!**/Uploads/**/.gitkeep

# --------------------------------------------------
# Entity Framework Bundle Tools
# --------------------------------------------------
efbundle.exe
efbundle

# --------------------------------------------------
# Operating System & Office Temp Files
# --------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
~$*
