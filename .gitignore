## =========================================================================
## ASP.NET Core & .NET Solution .gitignore
## =========================================================================

# --------------------------------------------------
# Build Results & Binary Output
# --------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
**/[Bb]in/
**/[Oo]bj/
**/[Ll]og/
**/[Ll]ogs/
**/publish/

# Output & Log files
*.dll
*.exe
*.pdb
*.deps.json
*.runtimeconfig.json
*.runtimeconfig.dev.json
*.log
*.tmp
*.temp

# --------------------------------------------------
# Visual Studio
# --------------------------------------------------
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
*.slnx.sqlite
*.dbmdl
*.jsproj.user
*.vsp
*.vspx
*.pidb
UpgradeLog.htm
UpgradeReport.sarif

# --------------------------------------------------
# Visual Studio Code
# --------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
.ionide/

# --------------------------------------------------
# JetBrains Rider / ReSharper
# --------------------------------------------------
.idea/
*.sln.iml
_ReSharper*/
*.DotSettings.user

# --------------------------------------------------
# HTTP Client / Endpoints Testing
# --------------------------------------------------
*.http.user
http-client.env.json
http-client.private.env.json

# --------------------------------------------------
# NuGet & Package Caches
# --------------------------------------------------
*.nuget.props
*.nuget.targets
project.lock.json
project.assets.json
*.nuget.cache
*.assets.cache

# --------------------------------------------------
# Test & Code Coverage
# --------------------------------------------------
[Tt]est[Rr]esults/
[Tt]est[Rr]esult*/
*.trx
coverage*.json
coverage*.xml
*.coverage
*.coveragexml

# --------------------------------------------------
# Memory Dumps & Diagnostics
# --------------------------------------------------
*.dmp
*.dump
*.crashdump

# --------------------------------------------------
# Database Files & Local Storage
# --------------------------------------------------
*.mdf
*.ldf
*.ndf
*.db
*.db-shm
*.db-wal

# --------------------------------------------------
# Security, Certificates & Secrets
# --------------------------------------------------
*.pfx
*.p12
*.key
secrets.json

# --------------------------------------------------
# User Secrets & Local Appsettings Overrides
# --------------------------------------------------
appsettings*.local.json
appsettings.local.json
appsettings.Development.local.json

# --------------------------------------------------
# Application Runtime Uploads (Lab 18 & Future Labs)
# Preserve directory structure via .gitkeep
# --------------------------------------------------
**/wwwroot/Files/**/*
!**/wwwroot/Files/**/.gitkeep
**/wwwroot/Uploads/**/*
!**/wwwroot/Uploads/**/.gitkeep
**/wwwroot/uploads/**/*
!**/wwwroot/uploads/**/.gitkeep

# --------------------------------------------------
# Entity Framework Bundle Tools
# --------------------------------------------------
efbundle.exe
efbundle

# --------------------------------------------------
# Operating System & Office Temp Files
# --------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
~$*