## =========================================================================
## ASP.NET Core & .NET Solution .gitignore
## =========================================================================

# --------------------------------------------------
# Build Results & Binary Output
# --------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
**/[Bb]in/
**/[Oo]bj/
**/[Ll]og/
**/[Ll]ogs/
**/publish/

# Output files
*.dll
*.exe
*.pdb
*.deps.json
*.runtimeconfig.json
*.runtimeconfig.dev.json

# --------------------------------------------------
# Visual Studio
# --------------------------------------------------
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
*.dbmdl
*.jsproj.user

# --------------------------------------------------
# Visual Studio Code
# --------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# --------------------------------------------------
# JetBrains Rider / Resharper
# --------------------------------------------------
.idea/
*.sln.iml
_ReSharper*/

# --------------------------------------------------
# NuGet & Package Caches
# --------------------------------------------------
*.nuget.props
*.nuget.targets
project.lock.json
project.assets.json
*.nuget.cache
*.assets.cache

# --------------------------------------------------
# Test & Code Coverage
# --------------------------------------------------
[Tt]est[Rr]esults/
[Tt]est[Rr]esult*/
*.trx
coverage*.json
coverage*.xml
*.coverage
*.coveragexml

# --------------------------------------------------
# Memory Dumps & Diagnostics
# --------------------------------------------------
*.dmp
*.dump
*.crashdump

# --------------------------------------------------
# Database Files & Local Storage
# --------------------------------------------------
*.mdf
*.ldf
*.ndf
*.db
*.db-shm
*.db-wal

# --------------------------------------------------
# User Secrets & Local Appsettings Overrides
# --------------------------------------------------
appsettings*.local.json
appsettings.local.json
appsettings.Development.local.json

# --------------------------------------------------
# Application Runtime Uploads (Lab 18)
# Preserve directory structure via .gitkeep
# --------------------------------------------------
**/wwwroot/Files/Users/*
!**/wwwroot/Files/Users/.gitkeep

# --------------------------------------------------
# Operating System Files
# --------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
[Dd]esktop.ini
$RECYCLE.BIN/